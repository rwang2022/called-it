# ── Database ───────────────────────────────────────────────────────────────
# Local dev uses a SQLite file. In production use Turso (libsql://...).
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# ── Auth (Google OAuth) ────────────────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials (see SETUP.md).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the site, no trailing slash. Required in production.
APP_URL=http://localhost:3000

# ── Claude ─────────────────────────────────────────────────────────────────
# Enables Claude as a player (sealed picks) and oracle on public bets.
ANTHROPIC_API_KEY=
# Max Claude calls per group per rolling 24h (cost guard).
CLAUDE_DAILY_LIMIT_PER_GROUP=40
# Dev only: fake Claude responses so the flow works without a key.
CLAUDE_MOCK=0

# ── Cron ───────────────────────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron.
CRON_SECRET=

# ── Notifications (Web Push) ───────────────────────────────────────────────
# A VAPID key pair identifies this server to browsers' push services. Make one
# with `npm run push:keys` (writes .env.local) or `npm run push:keys -- --print`.
# Generate once and keep it: a new pair breaks every existing subscription, so
# everyone would have to turn notifications on again.
# Leave both empty to turn notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@yourdomain.com or https://your-domain.
# Defaults to APP_URL when that is https. Apple rejects localhost here.
VAPID_SUBJECT=
